# ==============================================================================
# GhorBondhu (ঘরবন্ধু) - Environment Configuration Template
# ==============================================================================
# NOTE: Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS.
# Never expose secret API keys, service credentials, or webhook secrets in NEXT_PUBLIC_ vars.

# --- Firebase Client SDK (Public Web Credentials) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDummyApiKeyForLocalSetup00000000
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ghorbondhu-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ghorbondhu-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ghorbondhu-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=100000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:100000000000:web:abcdef1234567890abcdef

# --- Application URLs & Routing ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Firebase App Check (reCAPTCHA v3 / Enterprise) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# --- Payment Gateway Public Identifiers ---
NEXT_PUBLIC_ENABLE_ONLINE_PAYMENTS=true
NEXT_PUBLIC_BKASH_MERCHANT_NUMBER=01700000000
NEXT_PUBLIC_NAGAD_MERCHANT_NUMBER=01800000000

# ==============================================================================
# Server-Side Only Secrets (Cloud Functions / Node.js Backend - NOT NEXT_PUBLIC)
# ==============================================================================
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASS=
# SSLCOMMERZ_IS_LIVE=false
# SMS_GATEWAY_API_KEY=
# SMS_GATEWAY_SENDER_ID=
